datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Node {
  id            String    @id @default(uuid())
  name          String    @unique
  status        String    @default("HEALTHY")
  capacity      BigInt    @default(10737418240)
  usedCapacity  BigInt    @default(0)
  lastHeartbeat DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  replicas      Replica[]
  events        Event[]
}

model Object {
  id                String    @id @default(uuid())
  name              String
  size              BigInt
  contentType       String    @default("application/octet-stream")
  checksum          String
  version           Int       @default(1)
  replicationFactor Int       @default(3)
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  replicas          Replica[]
  events            Event[]
}

model Replica {
  id        String   @id @default(uuid())
  objectId  String
  nodeId    String
  version   Int      @default(1)
  checksum  String
  status    String   @default("HEALTHY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  object    Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([objectId])
  @@index([nodeId])
}

model Event {
  id        String   @id @default(uuid())
  type      String
  message   String
  objectId  String?
  nodeId    String?
  createdAt DateTime @default(now())

  object    Object?  @relation(fields: [objectId], references: [id], onDelete: SetNull)
  node      Node?    @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([objectId])
  @@index([nodeId])
  @@index([createdAt])
}
